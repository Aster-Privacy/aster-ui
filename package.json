{
  "name": "@aster/ui",
  "version": "0.1.0",
  "description": "Aster UI component library — buttons, badges, cards, banners, avatars, modals, tooltips, and more.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Aster Communications Inc.",
  "homepage": "https://astermail.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aster-Privacy/aster-ui"
  },
  "keywords": [
    "aster",
    "ui",
    "components",
    "react",
    "design-system",
    "privacy"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/styles/aster.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0"
  }
}
