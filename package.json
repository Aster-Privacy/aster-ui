{
  "name": "@aster/ui",
  "version": "0.1.1",
  "description": "Aster UI component library: buttons, badges, cards, banners, avatars, modals, tooltips, and more.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Aster Communications Inc.",
  "homepage": "https://astermail.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aster-Privacy/aster-ui.git"
  },
  "keywords": [
    "aster",
    "ui",
    "components",
    "react",
    "design-system",
    "privacy"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto/index.d.ts",
        "default": "./dist/crypto/index.js"
      },
      "require": {
        "types": "./dist/crypto/index.d.cts",
        "default": "./dist/crypto/index.cjs"
      }
    },
    "./styles": "./dist/styles/aster.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "framer-motion": ">=11.0.0",
    "openpgp": ">=6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "openpgp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "framer-motion": "^11.18.2",
    "openpgp": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
